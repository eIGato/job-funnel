# Copy to .env and fill in. .env is gitignored: secrets never get committed.
#   cp .env.example .env

# --- Postgres (read by docker-compose) ---
POSTGRES_USER=funnel
POSTGRES_PASSWORD=funnel
POSTGRES_DB=funnel
POSTGRES_PORT=5432

# --- Database (read by the application) ---
# Locally this is localhost; inside compose the host is overridden to `db`.
DATABASE_URL=postgresql+psycopg://funnel:funnel@localhost:5432/funnel

# --- Embeddings: local, fastembed/ONNX, no torch and no tokens ---
# Multilingual e5 (EN letters, but RU postings must embed sensibly). e5 needs query:/passage:
# prefixes — handled in matching/embed.py. e5-small isn't in fastembed 0.8.0; e5-large is the
# same family. English-only fallback (lighter, RU degrades): BAAI/bge-small-en-v1.5.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_CACHE_DIR=.cache/fastembed
# Postings per ONNX forward pass. fastembed's own default (256) allocates e5-large activations
# by the gigabyte and got a 501-posting backlog OOM-killed at ~13GB. Lower it further on a
# smaller box; raising it buys little, the CPU is the bottleneck either way.
EMBEDDING_BATCH_SIZE=16

# --- Profile (one active profile; multi-profile shelved, PLAN.md section 4) ---
# data/profiles/ is gitignored: _experience.md (shared) + <active>.md (the role header).
PROFILES_DIR=data/profiles
ACTIVE_PROFILE=backend

# --- Source APIs (aggregators; public, ToS-clean). Keys are free-tier. ---
# Adzuna: register a free app at https://developer.adzuna.com/ for the id/key pair.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# The Muse works without a key; a free key raises the rate limit (https://www.themuse.com/developers).
THEMUSE_API_KEY=

# --- Telegram (ingest only). A DEDICATED read-only account, never the human's main one. ---
# api_id/api_hash from https://my.telegram.org (Telethon). One-time login: `funnel auth-telegram`.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=secrets/telegram.session

# --- LLM: drafting/ and replies/ only ---
# pydantic-ai string of the form provider:model. Sonnet 5 chosen over cheaper Haiku for
# cover-letter quality (human-confirmed 2026-07-23, ~2x cost accepted). Still not frontier.
LLM_MODEL=anthropic:claude-sonnet-5
LLM_API_KEY=
COVER_LETTER_LANGUAGE=en
# Screen each candidate before drafting: one cheap call that declines a role whose emphasis is
# PHP/Node/fullstack, or an outright content mismatch, instead of writing a letter you then mark
# DECLINED by hand. Off = the old behaviour (a letter for everything in the top-N).
DRAFT_SCREEN=true
# Model for that screen. Empty = use LLM_MODEL. The screen is a coarse binary judgment, not
# prose, so a cheaper model than the one chosen for letter quality is the obvious setting:
#   SCREEN_MODEL=anthropic:claude-haiku-4-5-20251001
SCREEN_MODEL=
# Optional: drop a sample of your own writing at data/profiles/_writing_style.md (gitignored)
# and drafting/ uses it as a tone anchor. Absent by default; drafting works without it.

# --- Gmail: board alerts. We do not scrape LinkedIn. ---
# OAuth client secrets from the Google Cloud Console. Read-only scope by default.
GMAIL_CREDENTIALS_PATH=secrets/gmail_credentials.json
GMAIL_TOKEN_PATH=secrets/gmail_token.json
# Trash each alert email that ingest actually got postings out of, once they are committed.
# Recoverable for 30 days; an email that parsed into nothing is left alone. Turning this on
# widens the scope to gmail.modify (still cannot send) — re-run `uv run funnel auth-gmail`.
GMAIL_TRASH_PARSED_ALERTS=false

# --- Matching ---
# How many postings `draft` writes letters for, and the quality floor below which it writes
# fewer. The floor is a percentile (0-100) of the current shortlist, not a raw score: scores are
# centered on the corpus, so an absolute number would drift as the table grows.
MATCH_TOP_K=25
MATCH_PERCENTILE_THRESHOLD=90.0
# Score bonus for a remote posting when the shortlist is ordered. A preference, not a
# filter: on-site postings compete, they just start slightly behind. 0 sorts on merit alone.
REMOTE_BONUS=0.02

# --- Admin ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000
# The wall clock the admin shows and parses. The database stays UTC. An IANA zone name, not an
# offset: "+02:00" would be wrong for half the year.
ADMIN_TIMEZONE=Europe/Podgorica
