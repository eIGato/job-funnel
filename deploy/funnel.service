[Unit]
# Phase 7. A oneshot batch run, not a daemon: the container starts, works, and dies.
Description=Job-search funnel: ingest, match, draft (never sends)
Documentation=https://github.com/eIGato/job-funnel
# Only meaningful with a network; the timer's Persistent=true catches a missed run after boot.
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/src/common/job-funnel

# `run --rm` starts a throwaway container against the compose project's own db service.
# UV_NO_SYNC=1 is baked into the image (Phase 1) so a timer run never needs PyPI.
ExecStartPre=/usr/bin/docker compose up -d db
ExecStart=/usr/bin/docker compose run --rm app uv run funnel run-funnel

# The embedding model is the slow part: a cold e5-large fetch took ~11 min for 339 postings.
# Steady state is incremental and quick, but leave room rather than kill a first run.
TimeoutStartSec=45min

# A failed run is not an emergency — the next timer tick retries. No restart storms.
Restart=no

[Install]
WantedBy=default.target
